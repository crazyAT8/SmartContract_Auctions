# Production frontend (build-time Next.js public env)
# Copy to .env.production.local or set in the host/CI before `next build`.
# Never put PRIVATE_KEY or JWT_SECRET here — client-visible only.

NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
NEXT_PUBLIC_WS_URL=https://api.yourdomain.com
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
