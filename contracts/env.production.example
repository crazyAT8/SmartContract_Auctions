# Production / staging contract deploy
# Copy to contracts/.env — never commit real keys.

# Target RPC (must match backend ETHEREUM_RPC_URL network)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Dedicated deployer — never Hardhat default accounts
PRIVATE_KEY=

ETHERSCAN_API_KEY=
REPORT_GAS=false
