{
  "name": "auction-contracts",
  "version": "1.0.0",
  "description": "Smart contracts for auction dApp",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile --config hardhat.config.js",
    "export-abis": "node scripts/export-abis.js",
    "compile:abis": "hardhat compile --config hardhat.config.js && node scripts/export-abis.js",
    "export-artifacts": "node scripts/export-artifacts.js",
    "compile:artifacts": "hardhat compile --config hardhat.config.js && node scripts/export-artifacts.js",
    "test": "hardhat test --config hardhat.config.js",
    "deploy": "hardhat run scripts/deploy.js --config hardhat.config.js",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost --config hardhat.config.js",
    "smoke:local": "node scripts/local-chain-smoke.js",
    "e2e:local": "node scripts/local-chain-smoke.js",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia --config hardhat.config.js",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mainnet --config hardhat.config.js",
    "verify": "hardhat verify --config hardhat.config.js",
    "node": "hardhat node --config hardhat.config.js",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "^5.0.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "ethers": "^6.8.0",
    "hardhat": "^2.19.0",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  }
}
