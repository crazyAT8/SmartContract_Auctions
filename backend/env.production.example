# Production backend environment
# Copy to .env (or inject via your host/CI secrets). Never commit real values.
# Validate before start: NODE_ENV=production npm run check:prod-env

NODE_ENV=production
PORT=3001

# Local laptop smoke ONLY (never set on a real host/CI):
# ALLOW_LOCAL_PROD_SMOKE=1
# Lets NODE_ENV=production start against localhost DB/Redis/Hardhat for build&smoke.

# Managed Postgres (use SSL params your provider requires, e.g. ?sslmode=require)
DATABASE_URL="postgresql://USER:STRONG_PASSWORD@PROD_DB_HOST:5432/auction_dapp?schema=public&sslmode=require"

# Managed Redis (not localhost)
REDIS_HOST=PROD_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=STRONG_REDIS_PASSWORD

# Public frontend origin (CORS + Socket.IO)
FRONTEND_URL=https://app.yourdomain.com

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Public Ethereum RPC (Sepolia staging or mainnet). Never localhost / Hardhat :8545
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Dedicated deployer wallet. Never Hardhat account #0–9 keys.
PRIVATE_KEY=

# Path to deployments.json for the SAME network as ETHEREUM_RPC_URL
# After: npx hardhat run scripts/deploy.js --network sepolia|mainnet
CONTRACT_ADDRESSES_JSON=../contracts/deployments.json

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUCTION_END_CRON_INTERVAL_MS=60000
